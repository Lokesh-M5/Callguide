# Local development uses SQLite when both Supabase values are blank.
DATABASE_PATH=./callguide.db
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional hosted AI. The UI remains usable when this is blank.
GEMINI_API_KEY=
LLM_MODEL=gemini-3.8-flash

# Comma-separated origins; set the deployed Vercel origin in Render.
FRONTEND_ORIGIN=http://localhost:5173
